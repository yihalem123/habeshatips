# Postgres (docker compose up -d)
DATABASE_URL=postgres://habesha:habesha@localhost:5432/habeshatips

# Claude analysis step (pipeline/analyze)
ANTHROPIC_API_KEY=
ANALYSIS_MODEL=claude-opus-5-5

# Live fixtures, odds, injuries, lineups (https://www.api-football.com)
API_FOOTBALL_KEY=

# Telegram bot (Phase 3)
TELEGRAM_BOT_TOKEN=

# Chapa (Phase 2) https://developer.chapa.co
# Secret key from the dashboard (CHASECK_TEST-… in test mode, CHASECK-… live). Hosted checkout only needs this one.
CHAPA_SECRET_KEY=
# Public key and encryption key are only needed for inline/encrypted card flows; unused by hosted checkout.
CHAPA_PUBLIC_KEY=
CHAPA_ENCRYPTION_KEY=
# "Secret hash" you choose yourself in Dashboard → Settings → Webhooks, next to the webhook URL
# (https://<your-domain>/api/webhooks/chapa). Falls back to CHAPA_SECRET_KEY when unset.
CHAPA_WEBHOOK_SECRET=

# SMS gateway (Phase 3)
SMS_API_KEY=
SMS_SENDER_ID=

# Pipeline tuning (defaults shown)
MARKET_BLEND=0.8
DECAY_XI=0.002
ANALYSIS_EFFORT=medium
ROOM_PRICE_ETB=0

# Dry-run switches: serve canned API responses / skip the Claude call
# API_FOOTBALL_MOCK=1
# ANALYSIS_MOCK=1

# Requests per minute allowed by the API-Football plan (free 10, Pro 300)
API_FOOTBALL_RPM=10

# Free data providers (all optional; ESPN and OpenLigaDB need no key)
# football-data.org free token: fixtures, results, standings for all 6 competitions (10 req/min)
FOOTBALL_DATA_ORG_TOKEN=
# The Odds API free key: 500 credits/month; h2h + totals for 6 leagues daily ≈ 360 credits
THE_ODDS_API_KEY=
THE_ODDS_API_MONTHLY_CREDITS=500
# Provider preference per role (comma-separated). Defaults shown.
# FIXTURES_PROVIDERS=footballDataOrg,espn,openLigaDb
# RESULTS_PROVIDERS=footballDataOrg,espn,openLigaDb
# STANDINGS_PROVIDERS=footballDataOrg,openLigaDb
# ODDS_PROVIDERS=theOddsApi,espn
# PROVIDER_MOCK=1 serves canned responses from pipeline/__fixtures__/<provider>/

# Web app
SESSION_SECRET=
PUBLIC_ORIGIN=http://localhost:3000
PUBLIC_BASIS=model
OTP_DEV_SHOW=1

# Telegram (Phase 3). Create the bot with @BotFather, make it admin of each room channel
# and of the public results channel. Channel ids look like -1001234567890 (forward a post
# to @userinfobot or use getUpdates to read them). Store room channel ids in rooms.telegram_channel_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PUBLIC_CHANNEL_ID=
# TELEGRAM_MOCK=1 logs bot calls instead of sending

# SMS (Phase 3): AfroMessage (api.afromessage.com). One-way only in Ethiopia.
AFROMESSAGE_TOKEN=
AFROMESSAGE_IDENTIFIER=
AFROMESSAGE_SENDER=
# SMS_MOCK=1 forces the console provider even when a token is set
